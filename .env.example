# Copy this file to .env before running Docker Compose.
# Use long, unique values and never commit the populated .env file.
DB_PASSWORD=replace-with-a-strong-database-password
REDIS_PASSWORD=replace-with-a-strong-redis-password
JWT_SECRET=replace-with-at-least-32-random-characters

# Optional AI configuration. Leave AI_API_KEY empty to disable the AI assistant.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com
AI_MODEL=gpt-4
