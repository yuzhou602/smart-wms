# Copy this file to .env before running Docker Compose.
# Use long, unique values and never commit the populated .env file.
DB_PASSWORD=replace-with-a-strong-database-password
REDIS_PASSWORD=replace-with-a-strong-redis-password
JWT_SECRET=replace-with-at-least-32-random-characters

# Optional. Keep empty for same-origin Docker access through the frontend.
# Set comma-separated origins only when another site calls the backend directly.
CORS_ALLOWED_ORIGINS=

# Optional AI configuration. Keep provider as none to disable the AI assistant.
# Set AI_CHAT_PROVIDER=openai and provide a key to enable it.
AI_CHAT_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=https://api.openai.com
AI_MODEL=gpt-4
